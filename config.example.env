# Data policy
# NEVER use an indicative/derived feed as authoritative options flow.
OPTIONS_DATA_POLICY=authoritative_only

# Free sources below are research fallbacks only.
# ALPACA_INDICATIVE is intentionally disabled for authoritative alerts.
# It may be enabled separately for UI/testing, but alerts must be marked
# NON_AUTHORITATIVE.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_OPTIONS_FEED=indicative

# Paid/optional authoritative sources can be configured later:
OPTIONDATA_API_KEY=
UW_API_KEY=
DATABENTO_API_KEY=
