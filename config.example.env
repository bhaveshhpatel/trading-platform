# Research-only provider selection.
# alpaca = free indicative derivative (NOT full OPRA; trades delayed 15m)
# optiondata = optional trial/raw service records (NOT completeness guaranteed)
# unusual_whales = paid real-time flow provider
OPTIONS_FLOW_PROVIDER=alpaca

# Alpaca Basic market-data credentials
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_OPTIONS_FEED=indicative
# Explicit OCC option symbols; wildcard is intentionally disabled.
ALPACA_OPTION_SYMBOLS=AAPL240315C00172500,SPY240315P00450000

# Optional OptionData.io trial/raw stream
OPTIONDATA_API_KEY=
OPTIONDATA_WS_URL=wss://ws.optiondata.io
OPTIONDATA_SYMBOLS=

# Optional Tradier sandbox delayed snapshots (supplemental only)
TRADIER_SANDBOX_TOKEN=
TRADIER_BASE_URL=https://sandbox.tradier.com/v1

# Unusual Whales
UW_API_KEY=
UW_WS_SUBSCRIPTION_JSON={"subscribe":"option_trades"}
