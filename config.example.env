# Data policy
# NEVER use an indicative/derived feed as authoritative options flow.
OPTIONS_DATA_POLICY=authoritative_only

# E*TRADE market-data API (read-only adapter)
# Obtain an individual LIVE API key from the E*TRADE Developer Platform.
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=
ETRADE_ACCESS_TOKEN=
ETRADE_ACCESS_TOKEN_SECRET=
ETRADE_SANDBOX=false

# Free sources below are research fallbacks only.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_OPTIONS_FEED=indicative

# Paid/optional authoritative sources can be configured later:
OPTIONDATA_API_KEY=
UW_API_KEY=
DATABENTO_API_KEY=
